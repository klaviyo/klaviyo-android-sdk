<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded carousel notification: the current card's image, title and description, plus a footer
    with the prev arrow, "n / N" counter and next arrow. The image is hidden by the builder when a
    card has no downloaded bitmap. Only RemoteViews-safe views are used here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/klaviyo_carousel_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/klaviyo_carousel_image_height"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/klaviyo_carousel_content_padding"
        android:paddingEnd="@dimen/klaviyo_carousel_content_padding"
        android:paddingTop="@dimen/klaviyo_carousel_footer_spacing"
        android:paddingBottom="@dimen/klaviyo_carousel_footer_spacing">

        <TextView
            android:id="@+id/klaviyo_carousel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/klaviyo_carousel_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/klaviyo_carousel_footer_spacing"
            android:maxLines="3"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/klaviyo_carousel_content_padding"
        android:paddingEnd="@dimen/klaviyo_carousel_content_padding"
        android:paddingBottom="@dimen/klaviyo_carousel_content_padding">

        <ImageButton
            android:id="@+id/klaviyo_carousel_prev"
            android:layout_width="@dimen/klaviyo_carousel_arrow_size"
            android:layout_height="@dimen/klaviyo_carousel_arrow_size"
            android:background="@android:color/transparent"
            android:src="@drawable/klaviyo_carousel_prev"
            android:contentDescription="@string/klaviyo_carousel_prev_description" />

        <TextView
            android:id="@+id/klaviyo_carousel_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

        <ImageButton
            android:id="@+id/klaviyo_carousel_next"
            android:layout_width="@dimen/klaviyo_carousel_arrow_size"
            android:layout_height="@dimen/klaviyo_carousel_arrow_size"
            android:background="@android:color/transparent"
            android:src="@drawable/klaviyo_carousel_next"
            android:contentDescription="@string/klaviyo_carousel_next_description" />
    </LinearLayout>
</LinearLayout>
